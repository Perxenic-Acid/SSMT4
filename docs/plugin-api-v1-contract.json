  "errorCodes": [
    "backend_failed",
    "bridge_error",
    "capability_denied",
    "capability_not_supported",
    "directory_picker_failed",
    "external_manager_failed",
    "external_manager_invalid",
    "external_manager_missing",
    "external_manager_not_declared",
    "game_context_invalid",
    "game_context_unavailable",
    "host_action_failed",
    "invalid_payload",
    "lease_invalid",
    "lease_lookup_failed",
    "lease_required",
    "migration_not_declared",
    "plugin_api_incompatible",
    "plugin_data_error",
    "plugin_disabled",
    "plugin_not_installed",
    "plugin_registry_unavailable",
    "storage_error",
    "storage_unavailable"
  ],
  "compatibilityRules": {
    "unknownManifestFields": "reject",
    "capabilityRemovalWithinMajor": "forbidden",
    "capabilityRenameWithinMajor": "forbidden",
    "capabilityMeaningChangeWithinMajor": "forbidden",
    "additiveCapabilitiesAllowed": true,
    "bridgeBreakingChangeRequiresProtocolBump": true,
    "pageRemovalRequiresMajor": true,
    "pluginUpdatesMayChangeBundledUi": true,
    "hostUpdatesMustNotRequirePluginRebuild": true,
    "futurePluginApi": "install-visible-incompatible"
  }

      ]
    },
    {
      "id": "host.directory.select",
      "permissions": [
        "filesystem.read"
      ]
    },
    {
      "id": "host.url.open",
      "permissions": [
        "process.spawn"
      ]
    },
    {
      "id": "plugin.backend.request",
      "permissions": [
        "process.spawn"
      ]
    },
    {
      "id": "plugin.data.list",
      "permissions": [
        "filesystem.read"
      ]
    },
    {
      "id": "plugin.data.publish",
      "permissions": [
        "filesystem.write"
      ]
    },
    {
      "id": "plugin.data.read",
      "permissions": [
        "filesystem.read"
      ]
    },
    {
      "id": "plugin.data.remove",
      "permissions": [
        "filesystem.write"
      ]
    },
    {
      "id": "plugin.data.runtime.read",
      "permissions": [
        "filesystem.read"
      ]
    },
    {
      "id": "plugin.data.write",
      "permissions": [
        "filesystem.write"
      ]
    },
    {
      "id": "plugin.external.open",
      "permissions": [
        "process.spawn"
      ]
    },
    {
      "id": "plugin.migration.read",
      "permissions": [
        "filesystem.read"
      ]
    },
    {
      "id": "plugin.settings.get",
      "permissions": []
    },
    {
      "id": "plugin.settings.remove",
      "permissions": []
    },
    {
      "id": "plugin.settings.set",
      "permissions": []
    },
    {
      "id": "plugin.storage.get",
      "permissions": [
        "filesystem.read"
      ]
    },
    {
      "id": "plugin.storage.remove",
      "permissions": [
        "filesystem.write"
      ]
    },
    {
      "id": "plugin.storage.set",
      "permissions": [
        "filesystem.write"
      ]
    }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssmt4.dev/schema/v1/metadata.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entryId", "gamePreset", "workspaceName", "uploadedAt", "capturedAt", "attribution", "generator", "lods", "fullData"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entryId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "gamePreset": { "type": "string", "enum": ["GIMI", "HIMI", "SRMI", "ZZMI", "ZZMIDX12", "WWMI", "EFMI", "NTEMI", "GF2", "IdentityV", "AILIMIT", "DOAV", "SnowBreak", "YYSLS", "APMI", "Naraka", "NarakaM"] },
    "workspaceName": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "description": { "type": ["string", "null"], "maxLength": 2000 },
    "uploadedAt": { "type": "string", "format": "date-time" },
    "capturedAt": { "type": ["string", "null"], "format": "date-time" },
    "gameBuild": { "type": ["string", "null"], "maxLength": 256 },
    "attribution": { "$ref": "#/$defs/attribution" },
    "supersedes": { "type": ["string", "null"] },
    "workspaceAliases": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" } },
    "generator": { "$ref": "#/$defs/generator" },
    "lods": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/lod" } },
    "fullData": { "$ref": "#/$defs/fullData" }
  },
  "$defs": {
    "attribution": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": { "mode": { "enum": ["anonymous", "custom"] }, "displayName": { "type": "string", "maxLength": 128 } },
      "allOf": [{ "if": { "properties": { "mode": { "const": "custom" } } }, "then": { "required": ["displayName"] } }]
    },
    "generator": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "validatorVersion"],
      "properties": { "name": { "type": "string", "maxLength": 64 }, "version": { "type": "string", "maxLength": 64 }, "validatorVersion": { "const": 1 } }
    },
    "hashAlias": {
      "type": "object", "additionalProperties": false, "required": ["hash", "alias"],
      "properties": { "hash": { "type": "string", "pattern": "^[0-9a-f]{8,16}$" }, "alias": { "type": "string", "maxLength": 256 } }
    },
    "skipIB": {
      "type": "object", "additionalProperties": false, "required": ["hash", "alias", "indexCount", "firstIndex"],
      "properties": { "hash": { "type": "string", "pattern": "^[0-9a-f]{8,16}$" }, "alias": { "type": "string", "maxLength": 256 }, "indexCount": { "type": "integer", "minimum": 0 }, "firstIndex": { "type": "integer", "minimum": 0 } }
    },
    "vs": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "hash"],
      "properties": { "enabled": { "type": "boolean" }, "hash": { "type": "string", "pattern": "^[0-9a-f]{8,64}$" } }
    },
    "lod": {
      "type": "object", "additionalProperties": false, "required": ["name", "drawIB", "skipIB", "vsCheck"],
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 128 }, "drawIB": { "type": "array", "items": { "$ref": "#/$defs/hashAlias" } }, "skipIB": { "type": "array", "items": { "$ref": "#/$defs/skipIB" } }, "vsCheck": { "type": "array", "items": { "$ref": "#/$defs/vs" } }, "componentAliases": { "type": "object", "maxProperties": 4096, "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" }, "additionalProperties": { "type": "string", "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" } } }
    },
    "fullData": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["available"], "properties": { "available": { "const": false } } },
        { "type": "object", "additionalProperties": false, "required": ["available", "archiveVersion", "objectKey", "sha256", "size", "uncompressedSize", "fileCount"], "properties": { "available": { "const": true }, "archiveVersion": { "const": 1 }, "objectKey": { "type": "string", "pattern": "^packages/sha256/[0-9a-f]{2}/[0-9a-f]{64}\\.ssmtws$" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "size": { "type": "integer", "minimum": 0 }, "uncompressedSize": { "type": "integer", "minimum": 0 }, "fileCount": { "type": "integer", "minimum": 0 } } }
      ]
    }
  }
}
